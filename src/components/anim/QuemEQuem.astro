---
/** Diagrama parado: empresa → modelo → aplicativo. */
const rows = [
	{ empresa: 'Anthropic', modelo: 'Claude', app: 'claude.ai e app Claude' },
	{ empresa: 'OpenAI', modelo: 'GPT', app: 'ChatGPT' },
	{ empresa: 'Google', modelo: 'Gemini', app: 'app Gemini e Gemini Notebook' },
];
---
<figure class="qq not-content">
	<div class="qq-grid" role="table" aria-label="Quem é quem: empresa, modelo e aplicativo">
		<div class="qq-row qq-head" role="row">
			<span role="columnheader">Empresa</span><span aria-hidden="true"></span><span role="columnheader">Modelo</span><span aria-hidden="true"></span><span role="columnheader">Aplicativo que você usa</span>
		</div>
		{rows.map((r) => (
			<div class="qq-row" role="row">
				<span role="cell">{r.empresa}</span><span class="qq-arrow" aria-hidden="true">→</span><b role="cell">{r.modelo}</b><span class="qq-arrow" aria-hidden="true">→</span><span role="cell">{r.app}</span>
			</div>
		))}
	</div>
	<figcaption><span class="ivr-hand">o modelo é o motor; o app, o carro</span></figcaption>
</figure>
<style>
	.qq {
		margin: 1.5rem 0 2rem;
		display: grid;
		gap: 10px;
	}
	.qq-grid {
		display: grid;
		background: var(--ivr-paper);
		border: 2px solid var(--ivr-ink);
		border-radius: 6px;
		overflow-x: auto;
	}
	.qq-row {
		display: grid;
		grid-template-columns: minmax(6.5rem, 1fr) 1.5rem minmax(5rem, 0.8fr) 1.5rem minmax(9rem, 1.6fr);
		gap: 8px;
		align-items: center;
		padding: 12px 16px;
		border-top: 1px dashed var(--ivr-line);
		color: var(--ivr-ink);
	}
	.qq-head {
		border-top: 0;
		font: 500 11px/1.3 var(--ivr-font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ivr-ink-soft);
	}
	.qq-row b {
		font: 900 1.25rem/1 var(--ivr-font-display);
		letter-spacing: -0.03em;
	}
	.qq-arrow {
		color: var(--ivr-orange);
		font-weight: 700;
	}
</style>
