---
/**
 * As três maiores empresas e suas ferramentas, organizadas pelo uso.
 * Verificado em 08/10/2026 (ver notas do slide). Produtos mudam rápido: revisar antes de cada turma.
 */
const usos = ['Conversar', 'Executar tarefas sozinho', 'Programar e automatizar', 'Criar imagem e vídeo'];
const empresas = [
	{ nome: 'Anthropic', itens: ['Claude', 'Claude Cowork (também no Chrome)', 'Claude Code', 'Não gera imagem nem vídeo'] },
	{ nome: 'OpenAI', itens: ['ChatGPT', 'ChatGPT Work', 'Codex', 'Imagens no ChatGPT'] },
	{ nome: 'Google', itens: ['Gemini e Gemini Notebook', 'Modo agente do Gemini', 'Antigravity e Gemini CLI', 'Imagens no Gemini, vídeos no Flow'] },
];
---
<div class="pv not-content" role="table" aria-label="Ferramentas das três maiores empresas de IA, por uso">
	<div class="pv-row pv-head" role="row">
		<span role="columnheader"></span>
		{empresas.map((e) => <b role="columnheader">{e.nome}</b>)}
	</div>
	{usos.map((uso, i) => (
		<div class="pv-row" role="row">
			<span class="pv-use" role="rowheader">{uso}</span>
			{empresas.map((e) => <span role="cell" class:list={[e.itens[i].startsWith('Não') && 'pv-none']}>{e.itens[i]}</span>)}
		</div>
	))}
</div>
<style>
	.pv {
		display: grid;
		background: var(--ivr-paper);
		border: 2px solid var(--ivr-ink);
		border-radius: 6px;
		overflow-x: auto;
		color: var(--ivr-ink);
	}
	.pv-row {
		display: grid;
		grid-template-columns: minmax(9rem, 1fr) repeat(3, minmax(9rem, 1.2fr));
		gap: 12px;
		align-items: baseline;
		padding: 12px 16px;
		border-top: 1px dashed var(--ivr-line);
	}
	.pv-head {
		border-top: 0;
		border-bottom: 2px solid var(--ivr-ink);
	}
	.pv-head b {
		font: 900 1.3rem/1 var(--ivr-font-display);
		letter-spacing: -0.03em;
	}
	.pv-use {
		font: 500 12px/1.3 var(--ivr-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ivr-ink-soft);
	}
	.pv-none {
		color: var(--ivr-ink-soft);
		font-style: italic;
	}
</style>
