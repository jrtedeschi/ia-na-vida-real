---
import './token-split.css';
interface Props {
	tokens: string;
	circle?: string;
	note?: string;
	/** Nome na conta final. No material de estudo, "tokens"; no slide, "fragmentos". */
	unit?: string;
	/** Nome em inglês, escrito à mão depois da conta. Ex.: "em inglês, tokens". */
	alias?: string;
	before?: string;
	after?: string;
	trigger?: 'visible' | 'manual';
	hideCaption?: boolean;
}
const { tokens, circle, note, unit, alias, before, after, trigger, hideCaption } = Astro.props;
---
<div class="ivr-anim not-content">
	<ivr-token-split
		tokens={tokens}
		circle={circle}
		note={note}
		unit={unit}
		alias={alias}
		before={before}
		after={after}
		trigger={trigger}
		hide-caption={hideCaption || undefined}
	></ivr-token-split>
</div>
<script>import './token-split.js';</script>
