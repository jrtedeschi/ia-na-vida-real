{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/review-lint.mjs\"",
            "timeout": 20,
            "statusMessage": "Conferindo o guia de revisão"
          }
        ]
      }
    ]
  }
}
